# Neon / Vercel Postgres bağlantı dizesi.
# Vercel'de Storage sekmesinden Postgres eklendiğinde otomatik set edilir.
# Lokalde: Neon dashboard > Connection string (pooled) değerini kopyala.
POSTGRES_URL=postgresql://user:password@host/dbname?sslmode=require

# Yazma yapan tüm API endpoint'lerinin Bearer token'ı.
# ZORUNLU: tanımlı değilse yazma endpoint'leri fail-closed olarak 503 döner
# (takım ekle/sil, sıralama, değerlendirme tetikleme, skor POST).
# Aynı değeri /admin sayfasındaki "Operatör Token" alanına da gir.
INGEST_TOKEN=uzun-rastgele-bir-deger-uret

# Değerlendirme skorlarının POST edileceği adres — /evaluate ve /process-queue
# skill'leri bunu okur. Lokal geliştirmede http://localhost:3000
EVALUATOR_API_BASE=https://hackathon-evaluator-eta.vercel.app

# Geç teslim kontrolü (opsiyonel). Tanımlı DEĞİLSE geç commit cezası hiç
# uygulanmaz. Hackathon deadline'ını ISO-8601 + timezone ile ver:
# EVAL_LATE_CUTOFF=2026-05-14T17:30:00+03:00
